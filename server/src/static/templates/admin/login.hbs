<main class="auth-screen">
    <div class="card auth-card">
        <h1>umewarden Admin</h1>
        <p class="text-muted">Enter the admin token to continue.</p>

        {{#if error}}
        <div class="banner" data-type="error" style="margin-top:16px;">{{error}}</div>
        {{/if}}

        <form method="post" action="{{urlpath}}/admin">
            <label>Admin token
                <input type="password" autocomplete="current-password" name="token" placeholder="Enter admin token" autofocus>
            </label>
            {{#if redirect}}
            <input type="hidden" id="redirect" name="redirect" value="/{{redirect}}">
            {{/if}}
            <button type="submit" data-variant="primary">Enter</button>
        </form>
    </div>
</main>
