{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umewarden Client",
  "version": "0.1.0",
  "identifier": "io.umewarden.client",

  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420"
  },

  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Umewarden Client",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "hiddenTitle": false,
        "center": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "Umewarden Client"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Utility",
    "shortDescription": "A minimal password manager",
    "longDescription": "Lightweight desktop client for Umewarden (Bitwarden-compatible) servers, with local KDBX support, built with Rust and Tauri"
  }
}
